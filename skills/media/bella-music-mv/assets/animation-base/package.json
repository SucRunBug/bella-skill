{
  "name": "bella-music-mv-runtime",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Local p5.brush music-video authoring and verified rendering runtime",
  "scripts": {
    "check": "node render.mjs --check",
    "test": "node --test render-utils.test.mjs",
    "sheet": "node render.mjs --example=demo --sheet=0,1,2,3 --out=out/example-sheet.jpg",
    "video": "node render.mjs --clip --out=out/video.mp4"
  },
  "dependencies": {
    "p5": "^2.3.3",
    "p5.brush": "^2.2.3",
    "puppeteer-core": "^25.11.0"
  }
}
